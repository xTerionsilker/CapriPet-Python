<Window x:Class="CapriPet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CapriPet.Views"
        xmlns:controls="clr-namespace:CapriPet.Views.Controls"
        mc:Ignorable="d"
        Title="CapriPet Scale Config"
        Height="250" Width="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="{StaticResource CyberFont}">

    <Window.Resources>
        <!-- Красно-черный бегунок слайдера (Arasaka Crimson) -->
        <Style x:Key="CyberSliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="16" Height="28"
                                Background="#FFFE0929"
                                BorderBrush="#FFFE0929"
                                BorderThickness="1.5"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#FFFE0929" Opacity="0.95"/>
                            </Border.Effect>
                            <!-- Черная риска по центру бегунка -->
                            <Line X1="3" Y1="14" X2="11" Y2="14"
                                  Stroke="#FF040017" StrokeThickness="2.5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Красно-черный трек слайдера -->
        <Style x:Key="CyberSlider" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Фоновый трек -->
                            <Border Height="8"
                                    Background="#FF040017"
                                    BorderBrush="#FFFE0929"
                                    BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFFE0929" Opacity="0.6"/>
                                </Border.Effect>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CyberSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Основная панель в фирменном красно-черном стиле со скошенными углами -->
    <controls:CyberChamferBorder Background="#FA040017"
                                 BorderBrush="#FFFE0929"
                                 BorderThickness="2"
                                 AccentBrush="#FFFE0929"
                                 ChamferSize="16"
                                 Padding="24,18"
                                 Margin="10">
        <controls:CyberChamferBorder.Effect>
            <!-- Агрессивное неоновое алое свечение (Arasaka Crimson #fe0929) -->
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.9" Color="#FFFE0929"/>
        </controls:CyberChamferBorder.Effect>

        <StackPanel>
            <!-- Заголовок окна -->
            <DockPanel LastChildFill="False" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="[02] //"
                               Foreground="#FFFE0929"
                               FontWeight="Bold"
                               FontSize="11"/>
                    <TextBlock Text="CAPRI_SCALE_MODULE"
                               Foreground="#FFFE0929"
                               FontWeight="Bold"
                               FontSize="11"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Кнопка закрытия окна (Cyber Red) -->
                <Button Content="✕"
                        DockPanel.Dock="Right"
                        Foreground="#FFFE0929"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="Закрыть настройки">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>

            <!-- Информационная плашка с текущим размером (Черный фон + Красный текст и рамка) -->
            <Border Background="#FF040017"
                    BorderBrush="#FFFE0929"
                    BorderThickness="1.5"
                    Padding="14,10"
                    Margin="0,0,0,18">
                <DockPanel>
                    <TextBlock Text="ТЕКУЩИЙ РАЗМЕР:"
                               Foreground="#FFFE0929"
                               FontSize="11"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Название пресета (Cyber Red) -->
                        <Border Background="#33FE0929"
                                BorderBrush="#FFFE0929"
                                BorderThickness="1.5"
                                Padding="10,3"
                                Margin="0,0,10,0">
                            <TextBlock Text="{Binding ScaleDisplayName}"
                                       Foreground="#FFFE0929"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>

                        <!-- Пиксели (Cyber Red) -->
                        <TextBlock Text="{Binding ScalePixelText}"
                                   Foreground="#FFFE0929"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Ползунок выбора размера (0 = Tiny ... 6 = Hardcore) -->
            <Slider Minimum="0" Maximum="6"
                    Value="{Binding ScaleStep, Mode=TwoWay}"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    Style="{StaticResource CyberSlider}"
                    Margin="6,0,6,10"/>

            <!-- Подписи делений под слайдером (Все в красно-черном стиле) -->
            <Grid Margin="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="TINY" HorizontalAlignment="Left" FontSize="9" FontWeight="Bold" Foreground="#FFFE0929"/>
                <TextBlock Grid.Column="1" Text="SMALL" HorizontalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#FFFE0929"/>
                <TextBlock Grid.Column="2" Text="MEDIUM" HorizontalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#FFFE0929"/>
                <TextBlock Grid.Column="3" Text="DEFAULT" HorizontalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#FFFE0929"/>
                <TextBlock Grid.Column="4" Text="BIG" HorizontalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#FFFE0929"/>
                <TextBlock Grid.Column="5" Text="VERY BIG" HorizontalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#FFFE0929"/>
                <TextBlock Grid.Column="6" Text="HARDCORE" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="#FFFE0929"/>
            </Grid>
        </StackPanel>
    </controls:CyberChamferBorder>
</Window>
