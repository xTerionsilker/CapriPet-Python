<Window x:Class="CapriPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CapriPet.ViewModels"
        mc:Ignorable="d"
        Title="CapriPet"
        Height="220" Width="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Контекстное меню по правому клику для удобного закрытия -->
    <Window.ContextMenu>
        <ContextMenu Background="#EE040017" BorderBrush="#FF4985F9" BorderThickness="1">
            <MenuItem Header="Закрыть CapriPet"
                      Foreground="#FFF0F1F5"
                      FontFamily="{StaticResource CyberFont}"
                      FontSize="12"
                      Command="{Binding CloseCommand}"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Только сам персонаж без лишних плашек и текста -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="{Binding CurrentSpriteSource}"
               Width="200" Height="200"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Cursor="Hand">
            <Image.Effect>
                <!-- Тонкое свечение по контуру персонажа -->
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="#FF4985F9"/>
            </Image.Effect>
        </Image>
    </Grid>
</Window>
