<Window x:Class="CapriPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CapriPet"
        mc:Ignorable="d"
        Title="CapriPet Overlay"
        Height="280" Width="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <!-- Диалоговое облачко (Speech Bubble) -->
            <RowDefinition Height="Auto"/>
            <!-- Тело питомца -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Диалоговое облачко -->
        <Border Grid.Row="0"
                Background="#EE1A1B26"
                BorderBrush="#FF7AA2F7"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="12,8"
                Margin="0,0,0,10"
                MaxWidth="220"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="CapriPet C#"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="#FF7AA2F7"
                               DockPanel.Dock="Left"/>
                    <Button Content="✕"
                            DockPanel.Dock="Right"
                            Foreground="#FFFF757F"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="11"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            ToolTip="Закрыть"/>
                </DockPanel>
                <TextBlock x:Name="SpeechText"
                           Text="Привет! Перетаскивай меня мышкой 🐾"
                           Foreground="#FFC0CAF5"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Питомец (интерактивный аватар с подсветкой) -->
        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <!-- Неоновое свечение вокруг питомца -->
            <Ellipse Width="120" Height="120">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#557AA2F7" Offset="0"/>
                        <GradientStop Color="#007AA2F7" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Основной круг питомца -->
            <Button x:Name="PetButton"
                    Width="90" Height="90"
                    Cursor="Hand"
                    Click="PetButton_Click"
                    ToolTip="Кликни меня!">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PetBorder"
                                Background="#DD1F2335"
                                BorderBrush="#FFBB9AF7"
                                BorderThickness="2"
                                CornerRadius="45">
                            <Grid>
                                <!-- Стилизованная мордочка питомца -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="PetFace"
                                               Text="( ^ ◕ ᴥ ◕ ^ )"
                                               Foreground="#FFFFFFFF"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PetMood"
                                               Text="⚡ READY"
                                               Foreground="#FF7DCFFF"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PetBorder" Property="BorderBrush" Value="#FF7DCFFF"/>
                                <Setter TargetName="PetBorder" Property="Background" Value="#FF24283B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
